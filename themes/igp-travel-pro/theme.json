{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 2,
  "settings": {
    "appearanceTools": true,
    "layout": {
      "contentSize": "1120px",
      "wideSize": "1280px"
    },
    "color": {
      "palette": [
        {
          "slug": "electric-orange",
          "color": "#ff5a2a",
          "name": "Electric Orange"
        },
        {
          "slug": "midnight-navy",
          "color": "#0f172a",
          "name": "Midnight Navy"
        },
        {
          "slug": "slate-muted",
          "color": "#64748b",
          "name": "Slate Muted"
        },
        {
          "slug": "panel",
          "color": "#ffffff",
          "name": "Panel"
        }
      ]
    },
    "spacing": {
      "units": [
        "px",
        "rem",
        "em",
        "%",
        "vw",
        "vh"
      ]
    },
    "typography": {
      "fluid": true
    }
  },
  "styles": {
    "color": {
      "background": "var(--igp-colors-page-mid)",
      "text": "var(--igp-colors-ink)"
    },
    "typography": {
      "fontFamily": "var(--igp-typography-font-family)",
      "lineHeight": "var(--igp-typography-line-height)"
    }
  }
}