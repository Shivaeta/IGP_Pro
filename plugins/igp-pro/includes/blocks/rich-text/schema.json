{
  "id": "rich_text",
  "version": "v1",
  "category": "content",
  "data_source": "manual",
  "render_callback": "igp_pro_render_block",
  "fields": {
    "heading": {
      "type": "object",
      "label": "Heading",
      "fields": {
        "text": {
          "type": "string",
          "default": ""
        },
        "level": {
          "type": "enum",
          "values": [
            "h2",
            "h3",
            "h4"
          ],
          "default": "h2"
        },
        "eyebrow": {
          "type": "string",
          "default": ""
        },
        "visible": {
          "type": "boolean",
          "default": true
        }
      }
    },
    "style": {
      "type": "object",
      "label": "Style",
      "fields": {
        "variant": {
          "type": "enum",
          "label": "Variant",
          "values": [
            "default",
            "article",
            "lead",
            "panel",
            "quote"
          ],
          "default": "default"
        },
        "density": {
          "type": "enum",
          "label": "Density",
          "values": [
            "compact",
            "comfortable",
            "spacious"
          ],
          "default": "comfortable"
        },
        "theme": {
          "type": "enum",
          "label": "Theme",
          "values": [
            "default",
            "brand",
            "neutral",
            "light",
            "dark",
            "accent",
            "muted"
          ],
          "default": "brand"
        },
        "container": {
          "type": "enum",
          "label": "Container",
          "values": [
            "narrow",
            "default",
            "wide",
            "full"
          ],
          "default": "wide"
        },
        "surface": {
          "type": "enum",
          "label": "Surface",
          "values": [
            "default",
            "flat",
            "elevated",
            "card",
            "tinted",
            "transparent"
          ],
          "default": "default"
        },
        "media_position": {
          "type": "enum",
          "label": "Media Position",
          "values": [
            "auto",
            "left",
            "right",
            "top",
            "bottom",
            "background",
            "none"
          ],
          "default": "auto"
        }
      }
    },
    "content": {
      "type": "text",
      "default": "Add rich text content."
    },
    "alignment": {
      "type": "enum",
      "values": [
        "left",
        "center",
        "right"
      ],
      "default": "left"
    },
    "width": {
      "type": "enum",
      "values": [
        "normal",
        "wide",
        "narrow"
      ],
      "default": "normal"
    },
    "variant": {
      "type": "enum",
      "values": [
        "default",
        "lead",
        "panel",
        "quote"
      ],
      "default": "default"
    }
  },
  "defaults": {
    "heading": {
      "text": "",
      "level": "h2",
      "eyebrow": "",
      "visible": true
    },
    "content": "Add rich text content.",
    "alignment": "left",
    "width": "normal",
    "variant": "default",
    "style": {
      "variant": "default",
      "density": "comfortable",
      "theme": "brand",
      "container": "wide",
      "surface": "default",
      "media_position": "auto"
    }
  },
  "validation": {},
  "variants": [
    "default",
    "article",
    "lead",
    "panel",
    "quote"
  ],
  "supports": {
    "heading": true,
    "style": true
  }
}
