  "defaults": {
    "eyebrow": "Vacation Packages",
    "title": "Popular Tours",
    "description": "",
    "source": "query",
    "items": [],
    "destination": [],
    "layout": "grid",
    "columns": 3,
    "limit": 6,
    "show_price": true,
    "show_rating": true,
    "show_excerpt": true,
    "show_meta": true,
    "cta_label": "Book a tour",
    "image_ratio": "landscape",
    "variant": "elevated"
  },
  "variants": ["grid", "slider", "list"],
  "validation": {}
}
