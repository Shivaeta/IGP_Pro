{
  "id": "tour_cards",
  "version": "v1",
  "category": "discovery",
  "data_source": "query",
  "fields": {
    "eyebrow": { "type": "string", "default": "Vacation Packages" },
    "title": { "type": "string", "default": "Popular Tours" },
    "description": { "type": "text", "default": "" },
    "source": { "type": "enum", "values": ["query", "manual"], "default": "query" },
    "items": { "type": "relationship", "post_type": "tour", "default": [] },
    "destination": { "type": "relationship", "post_type": "destination", "default": [] },
    "layout": { "type": "enum", "values": ["grid", "slider", "list"], "default": "grid" },
    "columns": { "type": "number", "default": 3, "min": 1, "max": 4 },
    "limit": { "type": "number", "default": 6, "min": 1, "max": 12 },
    "show_price": { "type": "boolean", "default": true },
    "show_rating": { "type": "boolean", "default": true },
    "show_excerpt": { "type": "boolean", "default": true },
    "show_meta": { "type": "boolean", "default": true },
    "cta_label": { "type": "string", "default": "Book a tour" },
    "image_ratio": { "type": "enum", "values": ["landscape", "portrait", "square"], "default": "landscape" },
    "variant": { "type": "enum", "values": ["elevated", "bordered", "compact"], "default": "elevated" }
