{
  "id": "destination_cards",
  "version": "v1",
  "category": "discovery",
  "data_source": "hybrid",
  "fields": {
    "heading": {
      "type": "object",
      "label": "Heading",
      "fields": {
        "text": {
          "type": "string",
          "default": "Trending Destinations"
        },
        "level": {
          "type": "enum",
          "values": [
            "h2",
            "h3",
            "h4"
          ],
          "default": "h2"
        },
        "eyebrow": {
          "type": "string",
          "default": "Vacation Packages"
        },
        "visible": {
          "type": "boolean",
          "default": true
        }
      }
    },
    "style": {
      "type": "object",
      "label": "Style",
      "fields": {
        "variant": {
          "type": "enum",
          "label": "Variant",
          "values": [
            "default",
            "grid",
            "carousel-safe",
            "list",
            "featured"
          ],
          "default": "default"
        },
        "density": {
          "type": "enum",
          "label": "Density",
          "values": [
            "compact",
            "comfortable",
            "spacious"
          ],
          "default": "comfortable"
        },
        "theme": {
          "type": "enum",
          "label": "Theme",
          "values": [
            "default",
            "brand",
            "neutral",
            "light",
            "dark",
            "accent",
            "muted"
          ],
          "default": "brand"
        },
        "container": {
          "type": "enum",
          "label": "Container",
          "values": [
            "narrow",
            "default",
            "wide",
            "full"
          ],
          "default": "wide"
        },
        "surface": {
          "type": "enum",
          "label": "Surface",
          "values": [
            "default",
            "flat",
            "elevated",
            "card",
            "tinted",
            "transparent"
          ],
          "default": "default"
        },
        "media_position": {
          "type": "enum",
          "label": "Media Position",
          "values": [
            "auto",
            "left",
            "right",
            "top",
            "bottom",
            "background",
            "none"
          ],
          "default": "auto"
        }
      }
    },
    "description": {
      "type": "text",
      "default": ""
    },
    "source": {
      "type": "enum",
      "values": [
        "manual",
        "query"
      ],
      "default": "query"
    },
    "items": {
      "type": "relationship",
      "post_type": "destination",
      "default": []
    },
    "layout": {
      "type": "enum",
      "values": [
        "grid",
        "slider",
        "mosaic"
      ],
      "default": "grid"
    },
    "columns": {
      "type": "number",
      "default": 4,
      "min": 2,
      "max": 4
    },
    "limit": {
      "type": "number",
      "default": 6,
      "min": 1,
      "max": 12
    },
    "show_excerpt": {
      "type": "boolean",
      "default": true
    },
    "show_count": {
      "type": "boolean",
      "default": true
    },
    "image_ratio": {
      "type": "enum",
      "values": [
        "landscape",
        "portrait",
        "square"
      ],
      "default": "portrait"
    },
    "variant": {
      "type": "enum",
      "values": [
        "elevated",
        "overlay",
        "bordered"
      ],
      "default": "overlay"
    }
  },
  "defaults": {
    "heading": {
      "text": "Trending Destinations",
      "level": "h2",
      "eyebrow": "Vacation Packages",
      "visible": true
    },
    "description": "",
    "source": "query",
    "items": [],
    "layout": "grid",
    "columns": 4,
    "limit": 6,
    "show_excerpt": true,
    "show_count": true,
    "image_ratio": "portrait",
    "variant": "overlay",
    "style": {
      "variant": "default",
      "density": "comfortable",
      "theme": "brand",
      "container": "wide",
      "surface": "default",
      "media_position": "auto"
    }
  },
  "variants": [
    "default",
    "grid",
    "carousel-safe",
    "list",
    "featured"
  ],
  "validation": {
    "manual_min_items": 1
  },
  "render_callback": "igp_pro_render_block",
  "supports": {
    "heading": true,
    "style": true
  }
}
