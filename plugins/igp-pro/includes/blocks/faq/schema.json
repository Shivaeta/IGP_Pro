{
  "id": "faq",
  "version": "v1",
  "category": "content",
  "data_source": "manual",
  "fields": {
    "heading": {
      "type": "object",
      "label": "Heading",
      "fields": {
        "text": {
          "type": "string",
          "default": "Frequently Asked Questions"
        },
        "level": {
          "type": "enum",
          "values": [
            "h2",
            "h3",
            "h4"
          ],
          "default": "h2"
        },
        "eyebrow": {
          "type": "string",
          "default": ""
        },
        "visible": {
          "type": "boolean",
          "default": true
        }
      }
    },
    "style": {
      "type": "object",
      "label": "Style",
      "fields": {
        "variant": {
          "type": "enum",
          "label": "Variant",
          "values": [
            "default",
            "accordion",
            "grouped",
            "compact"
          ],
          "default": "default"
        },
        "density": {
          "type": "enum",
          "label": "Density",
          "values": [
            "compact",
            "comfortable",
            "spacious"
          ],
          "default": "comfortable"
        },
        "theme": {
          "type": "enum",
          "label": "Theme",
          "values": [
            "default",
            "brand",
            "neutral",
            "light",
            "dark",
            "accent",
            "muted"
          ],
          "default": "brand"
        },
        "container": {
          "type": "enum",
          "label": "Container",
          "values": [
            "narrow",
            "default",
            "wide",
            "full"
          ],
          "default": "wide"
        },
        "surface": {
          "type": "enum",
          "label": "Surface",
          "values": [
            "default",
            "flat",
            "elevated",
            "card",
            "tinted",
            "transparent"
          ],
          "default": "default"
        },
        "media_position": {
          "type": "enum",
          "label": "Media Position",
          "values": [
            "auto",
            "left",
            "right",
            "top",
            "bottom",
            "background",
            "none"
          ],
          "default": "auto"
        }
      }
    },
    "items": {
      "type": "repeater",
      "fields": {
        "question": {
          "type": "string"
        },
        "answer": {
          "type": "text"
        }
      }
    }
  },
  "defaults": {
    "heading": {
      "text": "Frequently Asked Questions",
      "level": "h2",
      "eyebrow": "",
      "visible": true
    },
    "items": [
      {
        "question": "Question",
        "answer": "Answer"
      }
    ],
    "style": {
      "variant": "default",
      "density": "comfortable",
      "theme": "brand",
      "container": "wide",
      "surface": "default",
      "media_position": "auto"
    }
  },
  "variants": [
    "default",
    "accordion",
    "grouped",
    "compact"
  ],
  "validation": {},
  "render_callback": "igp_pro_render_block",
  "supports": {
    "heading": true,
    "style": true
  }
}
