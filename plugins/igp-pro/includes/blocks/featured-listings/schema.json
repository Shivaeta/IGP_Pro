{
  "id": "featured_listings",
  "version": "v1",
  "category": "discovery",
  "data_source": "hybrid",
  "fields": {
    "eyebrow": {
      "type": "string",
      "default": "Handpicked"
    },
    "title": {
      "type": "string",
      "default": "Featured Listings"
    },
    "description": {
      "type": "text",
      "default": ""
    },
    "post_type": {
      "type": "enum",
      "values": [
        "tour",
        "destination",
        "both"
      ],
      "default": "tour"
    },
    "items": {
      "type": "relationship",
      "post_type": "any",
      "default": []
    },
    "layout": {
      "type": "enum",
      "values": [
        "grid",
        "list",
        "slider"
      ],
      "default": "grid"
    },
    "columns": {
      "type": "number",
      "default": 3,
      "min": 1,
      "max": 4
    },
    "limit": {
      "type": "number",
      "default": 4,
      "min": 1,
      "max": 12
    },
    "show_excerpt": {
      "type": "boolean",
      "default": true
    },
    "show_price": {
      "type": "boolean",
      "default": true
    },
    "show_rating": {
      "type": "boolean",
      "default": true
    },
    "image_ratio": {
      "type": "enum",
      "values": [
        "landscape",
        "portrait",
        "square"
      ],
      "default": "landscape"
    },
    "variant": {
      "type": "enum",
      "values": [
        "elevated",
        "bordered",
        "compact"
      ],
      "default": "elevated"
    }
  },
  "defaults": {
    "eyebrow": "Handpicked",
    "title": "Featured Listings",
    "description": "",
    "post_type": "tour",
    "items": [],
    "layout": "grid",
    "columns": 3,
    "limit": 4,
    "show_excerpt": true,
    "show_price": true,
    "show_rating": true,
    "image_ratio": "landscape",
    "variant": "elevated"
  },
  "variants": [
    "grid",
    "list",
    "slider"
  ],
  "validation": {},
  "render_callback": "igp_pro_render_block"
}
