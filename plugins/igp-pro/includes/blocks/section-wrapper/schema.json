{
  "id": "section",
  "version": "v1",
  "category": "layout",
  "data_source": "manual",
  "fields": {
    "heading": {
      "type": "object",
      "label": "Heading",
      "fields": {
        "text": {
          "type": "string",
          "default": ""
        },
        "level": {
          "type": "enum",
          "values": [
            "h2",
            "h3",
            "h4"
          ],
          "default": "h2"
        },
        "eyebrow": {
          "type": "string",
          "default": ""
        },
        "visible": {
          "type": "boolean",
          "default": true
        }
      }
    },
    "style": {
      "type": "object",
      "label": "Style",
      "fields": {
        "variant": {
          "type": "enum",
          "label": "Variant",
          "values": [
            "default",
            "band",
            "split",
            "grid"
          ],
          "default": "default"
        },
        "density": {
          "type": "enum",
          "label": "Density",
          "values": [
            "compact",
            "comfortable",
            "spacious"
          ],
          "default": "comfortable"
        },
        "theme": {
          "type": "enum",
          "label": "Theme",
          "values": [
            "default",
            "brand",
            "neutral",
            "light",
            "dark",
            "accent",
            "muted"
          ],
          "default": "brand"
        },
        "container": {
          "type": "enum",
          "label": "Container",
          "values": [
            "narrow",
            "default",
            "wide",
            "full"
          ],
          "default": "wide"
        },
        "surface": {
          "type": "enum",
          "label": "Surface",
          "values": [
            "default",
            "flat",
            "elevated",
            "card",
            "tinted",
            "transparent"
          ],
          "default": "default"
        },
        "media_position": {
          "type": "enum",
          "label": "Media Position",
          "values": [
            "auto",
            "left",
            "right",
            "top",
            "bottom",
            "background",
            "none"
          ],
          "default": "auto"
        }
      }
    },
    "description": {
      "type": "text",
      "default": ""
    },
    "layout": {
      "type": "enum",
      "values": [
        "grid",
        "list",
        "carousel",
        "split"
      ],
      "default": "grid"
    },
    "columns": {
      "type": "number",
      "min": 1,
      "max": 4,
      "default": 3
    },
    "spacing": {
      "type": "enum",
      "values": [
        "compact",
        "normal",
        "relaxed"
      ],
      "default": "normal"
    },
    "variant": {
      "type": "enum",
      "values": [
        "default",
        "contained",
        "wide",
        "panel",
        "accent",
        "dark"
      ],
      "default": "default"
    },
    "align": {
      "type": "enum",
      "values": [
        "left",
        "center",
        "right"
      ],
      "default": "left"
    },
    "background": {
      "type": "enum",
      "values": [
        "none",
        "soft",
        "white",
        "sand",
        "dark",
        "brand"
      ],
      "default": "none"
    }
  },
  "defaults": {
    "heading": {
      "text": "",
      "level": "h2",
      "eyebrow": "",
      "visible": true
    },
    "description": "",
    "layout": "grid",
    "columns": 3,
    "spacing": "normal",
    "variant": "default",
    "align": "left",
    "background": "none",
    "style": {
      "variant": "default",
      "density": "comfortable",
      "theme": "brand",
      "container": "wide",
      "surface": "default",
      "media_position": "auto"
    }
  },
  "variants": [
    "default",
    "band",
    "split",
    "grid"
  ],
  "validation": {},
  "render_callback": "igp_pro_render_block",
  "supports": {
    "heading": true,
    "style": true
  }
}
