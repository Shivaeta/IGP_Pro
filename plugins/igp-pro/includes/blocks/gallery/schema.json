{
  "id": "gallery",
  "version": "v1",
  "category": "media",
  "data_source": "manual",
  "fields": {
    "heading": {
      "type": "object",
      "label": "Heading",
      "fields": {
        "text": {
          "type": "string",
          "default": ""
        },
        "level": {
          "type": "enum",
          "values": [
            "h2",
            "h3",
            "h4"
          ],
          "default": "h2"
        },
        "eyebrow": {
          "type": "string",
          "default": ""
        },
        "visible": {
          "type": "boolean",
          "default": true
        }
      }
    },
    "style": {
      "type": "object",
      "label": "Style",
      "fields": {
        "variant": {
          "type": "enum",
          "label": "Variant",
          "values": [
            "default",
            "grid",
            "masonry-safe",
            "slider-safe"
          ],
          "default": "default"
        },
        "density": {
          "type": "enum",
          "label": "Density",
          "values": [
            "compact",
            "comfortable",
            "spacious"
          ],
          "default": "comfortable"
        },
        "theme": {
          "type": "enum",
          "label": "Theme",
          "values": [
            "default",
            "brand",
            "neutral",
            "light",
            "dark",
            "accent",
            "muted"
          ],
          "default": "brand"
        },
        "container": {
          "type": "enum",
          "label": "Container",
          "values": [
            "narrow",
            "default",
            "wide",
            "full"
          ],
          "default": "wide"
        },
        "surface": {
          "type": "enum",
          "label": "Surface",
          "values": [
            "default",
            "flat",
            "elevated",
            "card",
            "tinted",
            "transparent"
          ],
          "default": "default"
        },
        "media_position": {
          "type": "enum",
          "label": "Media Position",
          "values": [
            "auto",
            "left",
            "right",
            "top",
            "bottom",
            "background",
            "none"
          ],
          "default": "auto"
        }
      }
    },
    "images": {
      "type": "repeater",
      "fields": {
        "url": {
          "type": "string",
          "label": "Image URL",
          "format": "image-url",
          "default": ""
        },
        "alt": {
          "type": "string",
          "label": "Alt text",
          "default": ""
        },
        "caption": {
          "type": "string",
          "label": "Caption",
          "default": ""
        }
      },
      "label": "Images"
    },
    "layout": {
      "type": "enum",
      "values": [
        "grid",
        "masonry",
        "slider"
      ],
      "default": "grid"
    },
    "columns": {
      "type": "number",
      "min": 1,
      "max": 4,
      "default": 3
    }
  },
  "defaults": {
    "heading": {
      "text": "",
      "level": "h2",
      "eyebrow": "",
      "visible": true
    },
    "images": [],
    "layout": "grid",
    "columns": 3,
    "style": {
      "variant": "default",
      "density": "comfortable",
      "theme": "brand",
      "container": "wide",
      "surface": "default",
      "media_position": "auto"
    }
  },
  "variants": [
    "default",
    "grid",
    "masonry-safe",
    "slider-safe"
  ],
  "validation": {},
  "render_callback": "igp_pro_render_block",
  "supports": {
    "heading": true,
    "style": true
  }
}
