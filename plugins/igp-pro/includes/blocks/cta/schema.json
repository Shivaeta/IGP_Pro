{
  "id": "cta",
  "version": "v1",
  "category": "conversion",
  "data_source": "manual",
  "fields": {
    "heading": {
      "type": "object",
      "label": "Heading",
      "fields": {
        "text": {
          "type": "string",
          "default": "Plan your next private tour with confidence"
        },
        "level": {
          "type": "enum",
          "values": [
            "h2",
            "h3",
            "h4"
          ],
          "default": "h2"
        },
        "eyebrow": {
          "type": "string",
          "default": "Ready to travel?"
        },
        "visible": {
          "type": "boolean",
          "default": true
        }
      }
    },
    "style": {
      "type": "object",
      "label": "Style",
      "fields": {
        "variant": {
          "type": "enum",
          "label": "Variant",
          "values": [
            "default",
            "inline",
            "banner",
            "split",
            "card"
          ],
          "default": "default"
        },
        "density": {
          "type": "enum",
          "label": "Density",
          "values": [
            "compact",
            "comfortable",
            "spacious"
          ],
          "default": "comfortable"
        },
        "theme": {
          "type": "enum",
          "label": "Theme",
          "values": [
            "default",
            "brand",
            "neutral",
            "light",
            "dark",
            "accent",
            "muted"
          ],
          "default": "brand"
        },
        "container": {
          "type": "enum",
          "label": "Container",
          "values": [
            "narrow",
            "default",
            "wide",
            "full"
          ],
          "default": "wide"
        },
        "surface": {
          "type": "enum",
          "label": "Surface",
          "values": [
            "default",
            "flat",
            "elevated",
            "card",
            "tinted",
            "transparent"
          ],
          "default": "default"
        },
        "media_position": {
          "type": "enum",
          "label": "Media Position",
          "values": [
            "auto",
            "left",
            "right",
            "top",
            "bottom",
            "background",
            "none"
          ],
          "default": "auto"
        }
      }
    },
    "subheading": {
      "type": "string",
      "default": "Talk to a specialist and convert your idea into a structured itinerary."
    },
    "button": {
      "type": "object",
      "fields": {
        "label": {
          "type": "string",
          "default": "Start planning"
        },
        "url": {
          "type": "string",
          "default": "/contact/"
        }
      }
    },
    "secondary_button": {
      "type": "object",
      "fields": {
        "label": {
          "type": "string",
          "default": "Browse tours"
        },
        "url": {
          "type": "string",
          "default": "/tours/"
        }
      }
    },
    "alignment": {
      "type": "enum",
      "values": [
        "center",
        "left",
        "right"
      ],
      "default": "center"
    },
    "show_badges": {
      "type": "boolean",
      "default": true
    },
    "badges": {
      "type": "repeater",
      "default": [
        {
          "label": "Best-price guidance"
        },
        {
          "label": "Flexible itinerary"
        },
        {
          "label": "Local support"
        }
      ]
    }
  },
  "defaults": {
    "heading": {
      "text": "Plan your next private tour with confidence",
      "level": "h2",
      "eyebrow": "Ready to travel?",
      "visible": true
    },
    "subheading": "Talk to a specialist and convert your idea into a structured itinerary.",
    "button": {
      "label": "Start planning",
      "url": "/contact/"
    },
    "secondary_button": {
      "label": "Browse tours",
      "url": "/tours/"
    },
    "alignment": "center",
    "show_badges": true,
    "badges": [
      {
        "label": "Best-price guidance"
      },
      {
        "label": "Flexible itinerary"
      },
      {
        "label": "Local support"
      }
    ],
    "style": {
      "variant": "default",
      "density": "comfortable",
      "theme": "brand",
      "container": "wide",
      "surface": "default",
      "media_position": "auto"
    }
  },
  "variants": [
    "default",
    "inline",
    "banner",
    "split",
    "card"
  ],
  "validation": {},
  "render_callback": "igp_pro_render_block",
  "supports": {
    "heading": true,
    "style": true
  },
  "block_id": "cta"
}
